# All optional. Live channels come from the public iptv-org index and need no backend.

# Proxy for streams that block browser playback (CORS / referer / http-only).
# `npm run dev` and `npm run preview` already include a built-in proxy at /hls-proxy,
# so this is only needed for static hosting (Vercel, nginx, Docker).
# Refer https://github.com/itzzzme/m3u8proxy to host one; the URL structure looks like this:
VITE_M3U8_PROXY_URL=<m3u8_proxy_server_name>/m3u8-proxy?url=
